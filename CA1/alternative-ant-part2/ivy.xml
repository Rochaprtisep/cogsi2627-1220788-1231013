<?xml version="1.0" encoding="UTF-8"?>
<ivy-module version="2.0">
    <info organisation="com.example" module="bookstore" revision="1.0.0"/>

    <!-- Equivalent to Gradle's implementation / runtimeOnly / testImplementation -->
    <configurations>
        <conf name="compile" description="Libraries needed to compile the application"/>
        <conf name="runtime" extends="compile" description="Libraries needed to run the application"/>
        <conf name="test" extends="runtime" description="Libraries needed to compile and run the tests"/>
    </configurations>

    <dependencies>
        <!-- No BOM: every version must be declared explicitly -->
        <dependency org="org.springframework.boot" name="spring-boot-starter-web" rev="3.5.9" conf="compile->default"/>
        <dependency org="org.springframework.boot" name="spring-boot-starter-data-jpa" rev="3.5.9" conf="compile->default"/>
        <dependency org="org.springframework.boot" name="spring-boot-starter-hateoas" rev="3.5.9" conf="compile->default"/>
        <dependency org="org.springframework.boot" name="spring-boot-starter-actuator" rev="3.5.9" conf="compile->default"/>

        <dependency org="com.h2database" name="h2" rev="2.3.232" conf="runtime->default"/>

        <dependency org="org.springframework.boot" name="spring-boot-starter-test" rev="3.5.9" conf="test->default"/>
        <dependency org="org.junit.platform" name="junit-platform-launcher" rev="1.12.2" conf="test->default"/>
    </dependencies>
</ivy-module>
