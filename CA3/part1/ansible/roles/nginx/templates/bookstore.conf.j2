# Managed by Ansible (CA3). Every request from the host goes through here to the app VM.
upstream bookstore_app {
    server {{ app_ip }}:{{ app_port }};
}

server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://bookstore_app;

        # $http_host keeps the port (localhost:8080), so the HATEOAS links point back to the proxy
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}