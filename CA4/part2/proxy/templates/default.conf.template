# Rendered at container startup: ${...} are replaced by the container's environment variables.
# Nginx variables such as $http_host are not environment variables, so they are kept as they are.

upstream bookstore_web {
    # "web" is resolved by Docker's DNS (service name in compose.yaml)
    server ${BACKEND_HOST}:${BACKEND_PORT};
}

server {
    listen ${NGINX_PORT} default_server;
    server_name _;

    # Health of Nginx itself (does not touch the application)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://bookstore_web;

        # $http_host keeps the port (localhost:8080), so the HATEOAS links point back to the proxy
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout    ${PROXY_READ_TIMEOUT};
    }
}
