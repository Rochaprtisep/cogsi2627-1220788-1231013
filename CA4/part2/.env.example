# Copy to .env (never committed) and fill in the values:
#   Copy-Item .env.example .env
# Docker Compose reads .env automatically from this folder.

# --- Images (Docker Hub) ---
DOCKERHUB_USER=o-teu-utilizador
IMAGE_TAG=1.0.0

# --- db: credentials and storage ---
DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=muda-isto
DB_PORT=9092
H2_VERSION=2.3.232

# --- web: Spring Boot ---
WEB_PORT=8080

# --- proxy: port exposed on the host and routing settings ---
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
PROXY_CONNECT_TIMEOUT=5s
PROXY_READ_TIMEOUT=30s
