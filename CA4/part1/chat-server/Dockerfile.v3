# Version 3: Multi-stage build with non-root user execution
# Stage 1: Build stage with full JDK
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /src

# Copy all source files and Gradle configuration
COPY . .

# Build application and copy dependencies
RUN chmod +x gradlew && \
    ./gradlew clean build packageApp --no-daemon

# Stage 2: Runtime stage with lightweight JRE and non-root user
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Create dedicated non-root group and user (Least Privilege principle)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy compiled JAR and dependencies from builder stage with ownership assigned to appuser
COPY --from=builder --chown=appuser:appgroup /src/app/build/libs/chat-server-*.jar /app/chat-server.jar
COPY --from=builder --chown=appuser:appgroup /src/app/build/libs/lib /app/lib

# Enforce execution under unprivileged non-root user
USER appuser

# Expose chat server port
EXPOSE 59001

# Run the chat server
ENTRYPOINT ["java", "-cp", "chat-server.jar:lib/*", "org.example.ChatServerApp", "59001"]

